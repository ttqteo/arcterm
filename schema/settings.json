{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wavetermdev/waveterm/pkg/wconfig/settings-type",
  "$ref": "#/$defs/SettingsType",
  "$defs": {
    "SettingsType": {
      "properties": {
        "app:*": {
          "type": "boolean"
        },
        "app:ctrlvpaste": {
          "type": "boolean"
        },
        "app:disablectrlshiftdisplay": {
          "type": "boolean"
        },
        "notify:*": {
          "type": "boolean"
        },
        "notify:os": {
          "type": "boolean"
        },
        "notify:toast": {
          "type": "boolean"
        },
        "notify:reply": {
          "type": "boolean"
        },
        "term:*": {
          "type": "boolean"
        },
        "term:fontsize": {
          "type": "number"
        },
        "term:fontfamily": {
          "type": "string"
        },
        "term:disablewebgl": {
          "type": "boolean"
        },
        "term:localshellpath": {
          "type": "string"
        },
        "term:localshellopts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "term:gitbashpath": {
          "type": "string"
        },
        "term:scrollback": {
          "type": "integer"
        },
        "term:copyonselect": {
          "type": "boolean"
        },
        "term:allowbracketedpaste": {
          "type": "boolean"
        },
        "term:shiftenternewline": {
          "type": "boolean"
        },
        "term:macoptionismeta": {
          "type": "boolean"
        },
        "term:cursor": {
          "type": "string"
        },
        "term:cursorblink": {
          "type": "boolean"
        },
        "term:bellindicator": {
          "type": "boolean"
        },
        "term:osc52": {
          "type": "string",
          "enum": [
            "focus",
            "always"
          ]
        },
        "term:trimtrailingwhitespace": {
          "type": "boolean"
        },
        "memory:vaultpath": {
          "type": "string"
        },
        "headless:runtime": {
          "type": "string"
        },
        "headless:openroutercheapmodel": {
          "type": "string"
        },
        "jarvis:vaultpath": {
          "type": "string"
        },
        "editor:minimapenabled": {
          "type": "boolean"
        },
        "editor:stickyscrollenabled": {
          "type": "boolean"
        },
        "editor:wordwrap": {
          "type": "boolean"
        },
        "editor:fontsize": {
          "type": "number"
        },
        "editor:inlinediff": {
          "type": "boolean"
        },
        "window:*": {
          "type": "boolean"
        },
        "window:reducedmotion": {
          "type": "boolean"
        },
        "window:magnifiedblockopacity": {
          "type": "number"
        },
        "window:magnifiedblocksize": {
          "type": "number"
        },
        "window:magnifiedblockblursecondarypx": {
          "type": "integer"
        },
        "conn:*": {
          "type": "boolean"
        },
        "conn:localhostdisplayname": {
          "type": "string"
        },
        "debug:*": {
          "type": "boolean"
        },
        "debug:pprofport": {
          "type": "integer"
        },
        "debug:pprofmemprofilerate": {
          "type": "integer"
        },
        "debug:webglstatus": {
          "type": "boolean"
        },
        "harness:preferredruntime": {
          "type": "string"
        },
        "harness:preferredmodel": {
          "type": "string"
        },
        "harness:updatecheck": {
          "type": "boolean"
        },
        "claude:*": {
          "type": "boolean"
        },
        "claude:activeaccount": {
          "type": "string"
        },
        "radar:auditruntime": {
          "type": "string"
        },
        "radar:auditmodel": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}