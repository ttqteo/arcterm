{
    "app:disablectrlshiftdisplay": false,
    "notify:os": true,
    "notify:toast": true,
    "notify:reply": true,
    "storage:autoclean": true,
    "storage:nudgegb": 2,
    "window:minimize": "sprout",
    "editor:minimapenabled": true,
    "term:bellindicator": true,
    "term:osc52": "always",
    "term:cursor": "bar",
    "term:cursorblink": true,
    "term:fontsize": 14,
    "term:fontfamily": "\"JetBrains Mono\", monospace",
    "term:copyonselect": true,
    "term:rightclickpaste": true,
    "term:trimtrailingwhitespace": true,
    "harness:updatecheck": true,
    "agents:sleepidle": true,
    "agents:sleepaftermin": 30
}
