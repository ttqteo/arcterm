# generated wshrpc client files: Go is the source of truth, so parallel branches
# that add/change any RPC always conflict here. union keeps both sides' added
# command blocks; the tsgen golden/coverage guards fail if a union drifts from Go.
pkg/wshrpc/wshclient/wshclient.go   merge=union
frontend/app/store/wshclientapi.ts  merge=union
frontend/types/gotypes.d.ts         merge=union

# lists every branch appends to (CHANGELOG under one heading, the hand checks under one section): parallel
# branches that each add a line at the same spot conflict. union keeps both sides' lines, as AGENTS.md asks of a
# CHANGELOG conflict. A line one side removed beside one the other added can come back: delete it again by hand.
CHANGELOG.md                        merge=union
docs/open-issues.md                 merge=union
